name = "emi-lessons-access"
main = "src/index.js"
compatibility_date = "2026-05-04"

[[d1_databases]]
binding = "DB"
database_name = "emi-lesson-access"
database_id = "7edce485-a4f7-4be7-b4ff-70f867076376"

[vars]
PUBLIC_APP_ARCHIVE_URL = "https://ecstaticdancetokyo.com/#/lessons"
EMAIL_SUBJECT = "オンラインレッスン視聴確認"
ALLOWED_SUBSCRIPTION_STATUSES = "active,trialing"
ONE_OFF_ACCESS_WINDOW_DAYS = "90"
CHECKOUT_SESSION_SCAN_PAGES = "20"
SESSION_TTL_SECONDS = "3600"
PLAYBACK_CONTINUATION_SECONDS = "14400"
DO_SPACES_ENDPOINT = "https://lon1.digitaloceanspaces.com"
DO_SPACES_REGION = "lon1"
DO_SPACES_BUCKET = "agamirecords"
DO_SPACES_PREFIX = "thumbnails/online-community"

# Store these with wrangler secret put:
# STRIPE_SECRET_KEY
# RESEND_API_KEY
# EMAIL_FROM
# SESSION_SIGNING_SECRET
# DO_SPACES_KEY (DigitalOcean Spaces access key ID)
# DO_SPACES_SECRET

# Manage access from Stripe Dashboard product metadata:
# access_all=true to unlock all videos for this product
# access_videos=video-a.mp4,course1/lesson-2.mp4
# access_prefixes=course1/,membership/may/
